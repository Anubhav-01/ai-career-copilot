# ------------------------------------------------------------------
# AI Career Copilot - environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/career_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=career_copilot

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM provider: "mock" (no API key needed) or "openai" ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# --- Embeddings: "sentence-transformer" (requires ml extras) or "hashing" (dependency-free fallback) ---
EMBEDDING_PROVIDER=sentence-transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Redis cache (optional; falls back to in-memory cache when unset) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=5
ENVIRONMENT=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
